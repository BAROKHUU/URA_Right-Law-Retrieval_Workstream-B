{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build base index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_index.py",
      "console": "integratedTerminal",
      "args": ["--config", "configs/base.yaml"]
    },
    {
      "name": "Retrieve sample query",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/retrieve.py",
      "console": "integratedTerminal",
      "args": ["--config", "configs/base.yaml", "--query", "đăng ký đất đai"]
    },
    {
      "name": "Run H1",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_experiment.py",
      "console": "integratedTerminal",
      "args": ["--config", "configs/examples/h1_sparse_hierarchical.yaml"]
    },
    {
      "name": "Serve API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve_api.py",
      "console": "integratedTerminal",
      "args": ["--config", "configs/base.yaml"]
    }
  ]
}
